---
import { Image, inferRemoteSize } from "astro:assets";
import {z} from 'zod'
import { getProducts, getProduct } from "../../services/productService";
import Layout from "../../layouts/Layout.astro";

// === GET STATIC PATHS
export async function getStaticPaths() {
    const products = await getProducts();

    return products.map((product) => ({
        params: {
            id: product.id.toString(),
        },
    }));
}


// === ZOD VALIDATION 
const schema = z.coerce.number().int().positive()
const result = schema.safeParse(Astro.params.id)
if(!result.success) {
    return Astro.redirect('/404');
}
const productId = result.data;


// === GET PRODUCT
const product = await getProduct(String(productId));
const { width, height } = await inferRemoteSize(product.thumbnail);


---

<Layout title={product.title}>
    <Image
        src={product.thumbnail}
        alt={`Product image for ${product.title}`}
        width={width}
        height={height}
        format="webp"
    />

    <h2>
        {product.title}
    </h2>

    <p>
        {product.description}
    </p>

    <p>
        <a href={"/products"}> ← Back to Products </a>
    </p>
</Layout>
