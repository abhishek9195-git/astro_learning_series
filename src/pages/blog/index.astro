---
import { getCollection } from "astro:content";
const posts = await getCollection("blog");

console.log('==> Posts', posts);
---

<h1>Blog</h1>   

<ul>
  {
    posts.map((post: any) => (
      <li>
        <a href={`/blog/${post.id}`}>
          {post.data.title}
        </a>
      </li>
    ))
  }
</ul>
