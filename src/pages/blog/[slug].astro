import type { GetStaticPaths } from 'astro';


const {slug} = Astro.params
console.log(slug);

export const getStaticPaths = (() => {
    
    return [
        { params: {slug: 'astro-basics'}},
        { params: {slug: 'astro-routing'}},
        { params: {slug: 'astro-components'}},

    ];
}) satisfies GetStaticPaths;
