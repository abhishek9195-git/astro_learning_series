---
const title = "Learn Astro.js";
const subtitle =
  "Build fast, scalable and high-performance websites.";
---

<section class="hero">
  <h1>{title}</h1>
  <p>{subtitle}</p>

  <a href="/about">About</a>
</section>

<style>
.hero {
  text-align: center;
  padding: 5rem 2rem;
}

.hero h1 {
  font-size: 3rem;
  margin-bottom: 1rem;
}

.hero p {
  margin-bottom: 2rem;
}

.btn {
  background: #2563eb;
  color: white;
  padding: 12px 20px;
  text-decoration: none;
  border-radius: 8px;
}
</style>